
{
    "manifest_version": 3,
    "name": "TabFocus Enhancer",
    "description": "A Chrome Extension",
    "version": "0.0.1",
    "permissions": [
      "activeTab"
    ],
    "icons": {
        "128": "icon.png"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }
  
